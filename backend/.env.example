# Required for auth, documents, and safe folder
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=document-manager-fa2e2.firebasestorage.app

# Required for JWT auth tokens (use a long random string in production)
JWT_SECRET=your-secret-key

# Required for correct email signing links in production
FRONTEND_URL=https://document-manager-frontend-production.up.railway.app

